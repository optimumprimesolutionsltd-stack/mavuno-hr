import {
  pgTable,
  serial,
  text,
  integer,
  numeric,
  timestamp,
  date,
  jsonb,
  boolean,
} from "drizzle-orm/pg-core";

export const departments = pgTable("departments", {
  id: serial("id").primaryKey(),
  name: text("name").notNull(),
  code: text("code").notNull(),
  costCenter: text("cost_center"),
});

export const employees = pgTable("employees", {
  id: serial("id").primaryKey(),
  empNo: text("emp_no").notNull(),
  firstName: text("first_name").notNull(),
  lastName: text("last_name").notNull(),
  email: text("email").notNull(),
  phone: text("phone"),
  gender: text("gender").notNull().default("male"),
  nationalId: text("national_id"),
  kraPin: text("kra_pin"),
  nssfNo: text("nssf_no"),
  shifNo: text("shif_no"),
  bankName: text("bank_name"),
  bankAccount: text("bank_account"),
  departmentId: integer("department_id").references(() => departments.id),
  position: text("position").notNull(),
  employmentType: text("employment_type").notNull().default("permanent"), // permanent | contract | casual
  residentStatus: text("resident_status").notNull().default("resident"),
  basicSalary: numeric("basic_salary", { precision: 14, scale: 2 }).notNull(),
  houseAllowance: numeric("house_allowance", { precision: 14, scale: 2 }).notNull().default("0"),
  transportAllowance: numeric("transport_allowance", { precision: 14, scale: 2 }).notNull().default("0"),
  otherAllowance: numeric("other_allowance", { precision: 14, scale: 2 }).notNull().default("0"),
  insurancePremium: numeric("insurance_premium", { precision: 14, scale: 2 }).notNull().default("0"),
  pensionEmployee: numeric("pension_employee", { precision: 14, scale: 2 }).notNull().default("0"),
  helbMonthly: numeric("helb_monthly", { precision: 14, scale: 2 }).notNull().default("0"),
  hireDate: date("hire_date").notNull(),
  status: text("status").notNull().default("active"), // active | on_leave | terminated
  leaveBalance: numeric("leave_balance", { precision: 6, scale: 1 }).notNull().default("21"),
  passwordHash: text("password_hash"),
  mustChangePassword: boolean("must_change_password").notNull().default(true),
  createdAt: timestamp("created_at").notNull().defaultNow(),
});

export const payrollRuns = pgTable("payroll_runs", {
  id: serial("id").primaryKey(),
  period: text("period").notNull(), // e.g. 2026-01
  name: text("name").notNull(),
  status: text("status").notNull().default("draft"), // draft | approved | paid
  employeeCount: integer("employee_count").notNull().default(0),
  grossTotal: numeric("gross_total", { precision: 16, scale: 2 }).notNull().default("0"),
  netTotal: numeric("net_total", { precision: 16, scale: 2 }).notNull().default("0"),
  payeTotal: numeric("paye_total", { precision: 16, scale: 2 }).notNull().default("0"),
  nssfTotal: numeric("nssf_total", { precision: 16, scale: 2 }).notNull().default("0"),
  shifTotal: numeric("shif_total", { precision: 16, scale: 2 }).notNull().default("0"),
  housingLevyTotal: numeric("housing_levy_total", { precision: 16, scale: 2 }).notNull().default("0"),
  employerCostTotal: numeric("employer_cost_total", { precision: 16, scale: 2 }).notNull().default("0"),
  createdAt: timestamp("created_at").notNull().defaultNow(),
  approvedAt: timestamp("approved_at"),
  paidAt: timestamp("paid_at"),
});

export const payslips = pgTable("payslips", {
  id: serial("id").primaryKey(),
  runId: integer("run_id")
    .notNull()
    .references(() => payrollRuns.id, { onDelete: "cascade" }),
  employeeId: integer("employee_id")
    .notNull()
    .references(() => employees.id, { onDelete: "cascade" }),
  basic: numeric("basic", { precision: 14, scale: 2 }).notNull(),
  allowances: numeric("allowances", { precision: 14, scale: 2 }).notNull(),
  gross: numeric("gross", { precision: 14, scale: 2 }).notNull(),
  nssfEmployee: numeric("nssf_employee", { precision: 14, scale: 2 }).notNull(),
  nssfEmployer: numeric("nssf_employer", { precision: 14, scale: 2 }).notNull(),
  shif: numeric("shif", { precision: 14, scale: 2 }).notNull(),
  housingLevyEmployee: numeric("housing_levy_employee", { precision: 14, scale: 2 }).notNull(),
  housingLevyEmployer: numeric("housing_levy_employer", { precision: 14, scale: 2 }).notNull(),
  taxableIncome: numeric("taxable_income", { precision: 14, scale: 2 }).notNull(),
  payeBeforeRelief: numeric("paye_before_relief", { precision: 14, scale: 2 }).notNull(),
  personalRelief: numeric("personal_relief", { precision: 14, scale: 2 }).notNull(),
  insuranceRelief: numeric("insurance_relief", { precision: 14, scale: 2 }).notNull(),
  paye: numeric("paye", { precision: 14, scale: 2 }).notNull(),
  helb: numeric("helb", { precision: 14, scale: 2 }).notNull(),
  pension: numeric("pension", { precision: 14, scale: 2 }).notNull(),
  loanDeduction: numeric("loan_deduction", { precision: 14, scale: 2 }).notNull(),
  totalDeductions: numeric("total_deductions", { precision: 14, scale: 2 }).notNull(),
  netPay: numeric("net_pay", { precision: 14, scale: 2 }).notNull(),
  employerCost: numeric("employer_cost", { precision: 14, scale: 2 }).notNull(),
  breakdown: jsonb("breakdown"),
});

export const leaveRequests = pgTable("leave_requests", {
  id: serial("id").primaryKey(),
  employeeId: integer("employee_id")
    .notNull()
    .references(() => employees.id, { onDelete: "cascade" }),
  type: text("type").notNull(), // annual | sick | maternity | paternity | compassionate | study | unpaid
  startDate: date("start_date").notNull(),
  endDate: date("end_date").notNull(),
  days: numeric("days", { precision: 5, scale: 1 }).notNull(),
  reason: text("reason"),
  status: text("status").notNull().default("pending"), // pending | approved | rejected
  createdAt: timestamp("created_at").notNull().defaultNow(),
});

export const leaveDocuments = pgTable("leave_documents", {
  id: serial("id").primaryKey(),
  leaveRequestId: integer("leave_request_id")
    .notNull()
    .references(() => leaveRequests.id, { onDelete: "cascade" }),
  fileName: text("file_name").notNull(),
  storedName: text("stored_name").notNull(),
  mimeType: text("mime_type").notNull(),
  size: integer("size").notNull(),
  uploadedAt: timestamp("uploaded_at").notNull().defaultNow(),
});

export const loanRequests = pgTable("loan_requests", {
  id: serial("id").primaryKey(),
  employeeId: integer("employee_id")
    .notNull()
    .references(() => employees.id, { onDelete: "cascade" }),
  type: text("type").notNull(), // company | sacco | advance | emergency
  amount: numeric("amount", { precision: 14, scale: 2 }).notNull(),
  months: integer("months").notNull().default(12),
  reason: text("reason"),
  status: text("status").notNull().default("pending"), // pending | approved | rejected
  reviewNote: text("review_note"),
  loanId: integer("loan_id").references(() => loans.id),
  createdAt: timestamp("created_at").notNull().defaultNow(),
  reviewedAt: timestamp("reviewed_at"),
});

export const loans = pgTable("loans", {
  id: serial("id").primaryKey(),
  employeeId: integer("employee_id")
    .notNull()
    .references(() => employees.id, { onDelete: "cascade" }),
  type: text("type").notNull(), // company | sacco | advance | emergency
  principal: numeric("principal", { precision: 14, scale: 2 }).notNull(),
  balance: numeric("balance", { precision: 14, scale: 2 }).notNull(),
  monthlyInstallment: numeric("monthly_installment", { precision: 14, scale: 2 }).notNull(),
  interestRate: numeric("interest_rate", { precision: 5, scale: 2 }).notNull().default("0"),
  status: text("status").notNull().default("active"), // active | settled
  startDate: date("start_date").notNull(),
  createdAt: timestamp("created_at").notNull().defaultNow(),
});

export const auditLogs = pgTable("audit_logs", {
  id: serial("id").primaryKey(),
  action: text("action").notNull(),
  entity: text("entity").notNull(),
  detail: text("detail"),
  actor: text("actor").notNull().default("admin@zawadihr.co.ke"),
  createdAt: timestamp("created_at").notNull().defaultNow(),
});

export const appMeta = pgTable("app_meta", {
  key: text("key").primaryKey(),
  value: boolean("value").notNull().default(false),
});
