{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to the `H S% L%` channels the shadcn theme expects (web) and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f3f7f5", "$description": "Light counterpart for daytime or print-oriented surfaces." },
      "foreground": { "$value": "#0c1713" },
      "border": { "$value": "#d4e0da" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#0c1713" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#0c1713" },
      "primary": {
        "$value": "#049756",
        "$description": "Emerald action color from the Zawadi mark. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#e5eeea" },
      "secondaryForeground": { "$value": "#123126" },
      "muted": { "$value": "#e9f0ed" },
      "mutedForeground": { "$value": "#50645a" },
      "accent": { "$value": "#dce9e3" },
      "accentForeground": { "$value": "#123126" },
      "destructive": { "$value": "#b42318" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d4e0da" },
      "ring": { "$value": "#049756" },
      "chart1": { "$value": "#049756" },
      "chart2": { "$value": "#0f9fa5" },
      "chart3": { "$value": "#1879b8" },
      "chart4": { "$value": "#2f61c9" },
      "chart5": { "$value": "#6845c7" },
      "sidebar": { "$value": "#eaf2ee" },
      "sidebarForeground": { "$value": "#18352a" },
      "sidebarBorder": { "$value": "#d4e0da" },
      "sidebarPrimary": { "$value": "#049756" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#dce9e3" },
      "sidebarAccentForeground": { "$value": "#123126" },
      "sidebarRing": { "$value": "#049756" }
    },
    "dark": {
      "background": { "$value": "#0c0f12", "$description": "Canonical Zawadi cockpit background." },
      "foreground": { "$value": "#f5f7fa" },
      "border": { "$value": "#222831" },
      "card": { "$value": "#11161d" },
      "cardForeground": { "$value": "#f5f7fa" },
      "popover": { "$value": "#11161d" },
      "popoverForeground": { "$value": "#f5f7fa" },
      "primary": { "$value": "#10b981", "$description": "Emerald action color used by the existing Zawadi HR app." },
      "primaryForeground": { "$value": "#07110d" },
      "secondary": { "$value": "#222831" },
      "secondaryForeground": { "$value": "#f5f7fa" },
      "muted": { "$value": "#222831" },
      "mutedForeground": { "$value": "#9aa7b7" },
      "accent": { "$value": "#1b232d" },
      "accentForeground": { "$value": "#f5f7fa" },
      "destructive": { "$value": "#801d1d" },
      "destructiveForeground": { "$value": "#fff7f7" },
      "input": { "$value": "#222831" },
      "ring": { "$value": "#10b981" },
      "chart1": { "$value": "#10b981" },
      "chart2": { "$value": "#17d4d4" },
      "chart3": { "$value": "#1999e6" },
      "chart4": { "$value": "#3678f0" },
      "chart5": { "$value": "#6633f3" },
      "sidebar": { "$value": "#0e1318" },
      "sidebarForeground": { "$value": "#f5f7fa" },
      "sidebarBorder": { "$value": "#222831" },
      "sidebarPrimary": { "$value": "#10b981" },
      "sidebarPrimaryForeground": { "$value": "#07110d" },
      "sidebarAccent": { "$value": "#18212b" },
      "sidebarAccentForeground": { "$value": "#f5f7fa" },
      "sidebarRing": { "$value": "#10b981" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": {
        "$value": ["JetBrains Mono", "Fira Code", "monospace"],
        "$description": "Operational data, IDs, dates, labels, and dense numeric tables."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.3rem",
      "$description": "Tight cockpit radius from the existing Zawadi HR product; sm/md/lg/xl derive from this."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step the shadcn components multiply."
    }
  }
}
